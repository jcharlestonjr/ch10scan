  "zones": [
    {
      "id": "m1",
      "name": "Signal Flats",
      "milestone": "Milestone 1: the confidence channel",
      "pos": [0.10, 0.70],
      "quests": [
        { "id": "sensor", "name": "Build the confidence sensor", "xp": 150,
          "verify": { "files": ["confidence_sample.csv"] },
          "brief": "Put a sensor inside the model: entropy and top-token probability for every token, timestamped and saved to CSV." }
      ],
      "boss": {
        "name": "The Hallucinating Oracle",
        "lore": "Swore IRIG stood for \"International Radiometric Infrared Geodetic.\" Your entropy channel caught it guessing at token 6.",
        "xp": 200,
        "checks": [ { "label": "Confidence CSV recorded", "files": ["confidence_sample.csv"] } ]
      }
    },
    {
      "id": "m2",
      "name": "Packet Forge",
      "milestone": "Milestone 2: the TMATS writer",
      "pos": [0.28, 0.52],
      "quests": [
        { "id": "p1", "part": 1, "name": "Forge the header (build_header)", "xp": 100,
          "verify": { "tests": ["builds_known_header"] } },
        { "id": "p2", "part": 2, "name": "Wrap the TMATS (build_tmats_packet)", "xp": 150,
          "verify": { "tests": ["pads_to_32_bit_boundary", "length_fields_match_packet", "header_checksum_is_valid", "tmats_text_round_trips"] } }
      ],
      "boss": {
        "name": "The Checksum Golem",
        "lore": "Made of 24 bytes and suspicion. It only falls for a header a real recorder would accept.",
        "xp": 200,
        "checks": [
          { "label": "Header matches discrete.c10", "tests": ["builds_known_header"] },
          { "label": "Padding lands on 32 bits", "tests": ["pads_to_32_bit_boundary"] },
          { "label": "Length fields agree", "tests": ["length_fields_match_packet"] },
          { "label": "Checksum holds", "tests": ["header_checksum_is_valid"] },
          { "label": "TMATS text survives the trip", "tests": ["tmats_text_round_trips"] }
        ]
      }
    },
    {
      "id": "m3",
      "name": "Telemetry Wash",
      "milestone": "Milestone 3: confidence readings into Ch10",
      "pos": [0.46, 0.66],
      "quests": [
        { "id": "p3", "part": 3, "name": "Count the ticks (rtc_from_ns)", "xp": 50,
          "verify": { "tests": ["rtc_starts_at_zero", "rtc_converts_ns_to_10mhz_ticks"] } },
        { "id": "p4", "part": 4, "name": "Pack a reading (build_confidence_packet)", "xp": 100,
          "verify": { "tests": ["confidence_packet_layout"] } },
        { "id": "p5", "part": 5, "name": "Write every reading", "xp": 100,
          "verify": { "commit": "Milestone 3" },
          "brief": "Loop over every reading and append its packet. Verified by your Milestone 3 commit." }
      ],
      "boss": {
        "name": "The Byte Bandit",
        "lore": "Skims a byte here and there and hopes nobody counts. Your tests count.",
        "xp": 200,
        "checks": [
          { "label": "Sample CSV reads cleanly", "tests": ["reads_sample_csv"] },
          { "label": "RTC starts at zero", "tests": ["rtc_starts_at_zero"] },
          { "label": "Nanoseconds become 10 MHz ticks", "tests": ["rtc_converts_ns_to_10mhz_ticks"] },
          { "label": "Packet layout is exact", "tests": ["confidence_packet_layout"] }
        ]
      }
    },
    {
      "id": "m4",
      "name": "Clock Tower",
      "milestone": "Milestone 4: the time packet",
      "pos": [0.62, 0.40],
      "quests": [
        { "id": "p6", "part": 6, "name": "Speak BCD (bcd_doy_words)", "xp": 150,
          "verify": { "tests": ["bcd_matches_discrete_c10", "bcd_matches_event_c10", "bcd_packs_milliseconds"] } },
        { "id": "p7", "part": 7, "name": "Ring the bell (build_time_packet)", "xp": 100,
          "verify": { "tests": ["time_packet_layout", "time_packet_sets_leap_year_bit"] } },
        { "id": "p8", "part": 8, "name": "Anchor the clock", "xp": 50,
          "verify": { "commit": "Milestone 4" },
          "brief": "Anchor RTC 0 to a whole second. Verified by your Milestone 4 commit, but see the curse." }
      ],
      "curse": {
        "name": "The 1.996-second curse",
        "lore": "The bell rings early. Every reading in the milestone 4 file maps to a clock time 1.996 s too soon. Finish Recorder in Live Wire Pass to lift it.",
        "lifted_by": { "tests": ["recorder_first_reading_brings_headers", "recorder_later_readings_are_one_packet"] }
      },
      "boss": {
        "name": "The Chronomancer",
        "lore": "Keeps time in nibbles and never tells you which year it is.",
        "xp": 200,
        "checks": [
          { "label": "Calendar math lands on day 324", "tests": ["utc_parts_known_time"] },
          { "label": "Leap years sorted", "tests": ["leap_years"] },
          { "label": "BCD matches discrete.c10", "tests": ["bcd_matches_discrete_c10"] },
          { "label": "BCD matches event.c10", "tests": ["bcd_matches_event_c10"] },
          { "label": "Milliseconds packed", "tests": ["bcd_packs_milliseconds"] },
          { "label": "Time packet layout", "tests": ["time_packet_layout"] },
          { "label": "Leap-year bit set", "tests": ["time_packet_sets_leap_year_bit"] }
        ]
      }
    },
    {
      "id": "m5",
      "name": "Live Wire Pass",
      "milestone": "Milestone 5: live streaming",
      "pos": [0.80, 0.58],
      "quests": [
        { "id": "p9", "part": 9, "name": "Read the wire (parse_datagram)", "xp": 75,
          "verify": { "tests": ["datagram_parses", "datagram_wrong_length_is_rejected"] } },
        { "id": "p10", "part": 10, "name": "Build the Recorder (packets_for)", "xp": 150,
          "verify": { "tests": ["recorder_first_reading_brings_headers", "recorder_later_readings_are_one_packet"] } },
        { "id": "p11", "part": 11, "name": "Listen live (record loop)", "xp": 150,
          "verify": { "tests": ["udp_records_live_readings"] } },
        { "id": "field", "name": "Field run: stream the real model from Windows", "xp": 150,
          "verify": { "model_file": 1 },
          "brief": "Record target/model.c10 from a live model run on the 4060. See SESSION-milestone5.md." }
      ],
      "boss": {
        "name": "The Phantom Packet",
        "lore": "Arrives out of order, or not at all, and swears it was there. Only a byte-perfect recording banishes it.",
        "xp": 250,
        "checks": [
          { "label": "Datagrams parse", "tests": ["datagram_parses"] },
          { "label": "Bad datagrams rejected", "tests": ["datagram_wrong_length_is_rejected"] },
          { "label": "First reading brings TMATS and time", "tests": ["recorder_first_reading_brings_headers"] },
          { "label": "Later readings are one packet", "tests": ["recorder_later_readings_are_one_packet"] },
          { "label": "Live UDP round trip", "tests": ["udp_records_live_readings"] },
          { "label": "Final blow: live recording is byte-identical to CSV mode", "e2e": "byte_perfect" }
        ]
      }
    },
